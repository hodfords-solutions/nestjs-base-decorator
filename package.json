{
    "name": "@hodfords/nestjs-base-decorator",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "Provides common decorators for simplifying and standardizing NestJS application development",
    "main": "./index.js",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "start:dev": "pnpm run prebuild && nest start --watch -p tsconfig.sample.json",
        "build": "tsc",
        "format": "prettier --write \"lib/**/*.ts\"",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "prepare": "is-ci || husky",
        "version": "auto-changelog && git add CHANGELOG.md",
        "release:patch": "git add CHANGELOG.md && pnpm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "cspell": "cspell",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-base-decorator.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-base-decorator/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-base-decorator#readme",
    "devDependencies": {
        "@hodfords/nestjs-cls-translation": "12.1.0",
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-exception": "12.1.0",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@hodfords/typeorm-helper": "12.1.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/microservices": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/swagger": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@nestjs/typeorm": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/express": "5.0.6",
        "@types/multer": "2.2.0",
        "@types/node": "26.4.0",
        "@types/uuid": "11.0.0",
        "@types/validator": "13.15.10",
        "auto-changelog": "2.6.0",
        "class-transformer": "0.5.1",
        "class-validator": "npm:@hodfords/turbo-validator@1.0.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "multer": "2.3.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@hodfords/nestjs-exception": ">=12.0.0",
        "@hodfords/typeorm-helper": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/microservices": ">=12.0.0",
        "@nestjs/platform-express": ">=12.0.0",
        "@nestjs/swagger": ">=12.0.0",
        "class-validator": "*",
        "express": ">=5.0.0",
        "multer": ">=2.0.0",
        "rxjs": ">=7.0.0",
        "typeorm": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "express": {
            "optional": true
        },
        "rxjs": {
            "optional": true
        },
        "typeorm": {
            "optional": true
        }
    },
    "dependencies": {
        "@supercharge/request-ip": "1.2.0",
        "dayjs": "1.11.23",
        "es-toolkit": "1.52.0",
        "uuid": "^14.0.2"
    },
    "type": "module",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
